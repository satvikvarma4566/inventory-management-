-- =====================================================
-- INVENTORY MANAGEMENT SYSTEM
-- DBMS MINI PROJECT
-- =====================================================

CREATE DATABASE inventory_management;
USE inventory_management;


-- =====================================================
-- 1. SUPPLIER TABLE
-- =====================================================

CREATE TABLE supplier (
    sup_id INT PRIMARY KEY AUTO_INCREMENT,
    sup_name VARCHAR(100) NOT NULL,
    sup_email VARCHAR(100),
    sup_phone VARCHAR(15),
    sup_address VARCHAR(200)
);


-- =====================================================
-- 2. PRODUCT TABLE
-- =====================================================

CREATE TABLE product (
    prod_id INT PRIMARY KEY AUTO_INCREMENT,
    prod_name VARCHAR(100) NOT NULL,
    category VARCHAR(50),
    unit_price DECIMAL(10,2),
    reorder_level INT,
    sup_id INT,

    FOREIGN KEY (sup_id)
        REFERENCES supplier(sup_id)
);


-- =====================================================
-- 3. WAREHOUSE TABLE
-- =====================================================

CREATE TABLE warehouse (
    warehouse_id INT PRIMARY KEY AUTO_INCREMENT,
    warehouse_name VARCHAR(100) NOT NULL,
    location VARCHAR(100),
    capacity INT
);


-- =====================================================
-- 4. INVENTORY TABLE
-- =====================================================

CREATE TABLE inventory (
    inventory_id INT PRIMARY KEY AUTO_INCREMENT,
    prod_id INT,
    warehouse_id INT,
    quantity_on_hand INT,
    reorder_level INT,
    last_updated DATE,

    FOREIGN KEY (prod_id)
        REFERENCES product(prod_id),

    FOREIGN KEY (warehouse_id)
        REFERENCES warehouse(warehouse_id)
);


-- =====================================================
-- 5. CUSTOMER TABLE
-- =====================================================

CREATE TABLE customer (
    cust_id INT PRIMARY KEY AUTO_INCREMENT,
    cust_name VARCHAR(100) NOT NULL,
    cust_email VARCHAR(100),
    cust_phone VARCHAR(15),
    cust_address VARCHAR(200)
);


-- =====================================================
-- 6. PURCHASE ORDER TABLE
-- =====================================================

CREATE TABLE purchase_order (
    po_id INT PRIMARY KEY AUTO_INCREMENT,
    order_date DATE,
    total_amount DECIMAL(12,2),
    status VARCHAR(30),
    supplier_id INT,

    FOREIGN KEY (supplier_id)
        REFERENCES supplier(sup_id)
);


-- =====================================================
-- 7. SALES ORDER TABLE
-- =====================================================

CREATE TABLE sales_order (
    so_id INT PRIMARY KEY AUTO_INCREMENT,
    order_date DATE,
    total_amount DECIMAL(12,2),
    status VARCHAR(30),
    customer_id INT,

    FOREIGN KEY (customer_id)
        REFERENCES customer(cust_id)
);


-- =====================================================
-- 8. ORDER ITEM TABLE
-- =====================================================

CREATE TABLE order_item (
    order_item_id INT PRIMARY KEY AUTO_INCREMENT,
    po_id INT,
    so_id INT,
    inventory_id INT,
    product_id INT,
    quantity INT,
    unit_price DECIMAL(10,2),

    FOREIGN KEY (po_id)
        REFERENCES purchase_order(po_id),

    FOREIGN KEY (so_id)
        REFERENCES sales_order(so_id),

    FOREIGN KEY (inventory_id)
        REFERENCES inventory(inventory_id),

    FOREIGN KEY (product_id)
        REFERENCES product(prod_id)
);


