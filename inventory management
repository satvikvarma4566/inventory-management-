-- =====================================================
-- BASIC QUERIES
-- =====================================================

-- 1. Show all suppliers
SELECT * FROM supplier;


-- 2. Show all products
SELECT * FROM product;


-- 3. Show all customers
SELECT * FROM customer;


-- 4. Show all warehouses
SELECT * FROM warehouse;


-- 5. Show complete inventory
SELECT * FROM inventory;


-- =====================================================
-- PRODUCTS WITH SUPPLIER NAME
-- =====================================================

SELECT
    p.prod_id,
    p.prod_name,
    p.category,
    p.unit_price,
    s.sup_name
FROM product p
JOIN supplier s
ON p.sup_id = s.sup_id;


-- =====================================================
-- INVENTORY WITH PRODUCT AND WAREHOUSE
-- =====================================================

SELECT
    i.inventory_id,
    p.prod_name,
    w.warehouse_name,
    i.quantity_on_hand,
    i.reorder_level
FROM inventory i
JOIN product p
ON i.prod_id = p.prod_id
JOIN warehouse w
ON i.warehouse_id = w.warehouse_id;


-- =====================================================
-- PRODUCTS WHICH NEED RESTOCKING
-- =====================================================

SELECT
    p.prod_name,
    i.quantity_on_hand,
    i.reorder_level
FROM inventory i
JOIN product p
ON i.prod_id = p.prod_id
WHERE i.quantity_on_hand <= i.reorder_level;


-- =====================================================
-- CUSTOMER SALES ORDERS
-- =====================================================

SELECT
    c.cust_name,
    s.so_id,
    s.order_date,
    s.total_amount,
    s.status
FROM customer c
JOIN sales_order s
ON c.cust_id = s.customer_id;


-- =====================================================
-- PURCHASE ORDERS WITH SUPPLIER
-- =====================================================

SELECT
    p.po_id,
    p.order_date,
    p.total_amount,
    p.status,
    s.sup_name
FROM purchase_order p
JOIN supplier s
ON p.supplier_id = s.sup_id;


-- =====================================================
-- CALCULATE ORDER ITEM TOTAL
-- =====================================================

SELECT
    order_item_id,
    product_id,
    quantity,
    unit_price,
    quantity * unit_price AS item_total
FROM order_item;


-- =====================================================
-- TOTAL SALES
-- =====================================================

SELECT
    SUM(total_amount) AS total_sales
FROM sales_order;


-- =====================================================
-- TOTAL PURCHASE AMOUNT
-- =====================================================

SELECT
    SUM(total_amount) AS total_purchase
FROM purchase_order;


-- =====================================================
-- NUMBER OF PRODUCTS IN EACH CATEGORY
-- =====================================================

SELECT
    category,
    COUNT(*) AS total_products
FROM product
GROUP BY category;


-- =====================================================
-- MOST EXPENSIVE PRODUCT
-- =====================================================

SELECT *
FROM product
ORDER BY unit_price DESC
LIMIT 1;


-- =====================================================
-- PRODUCTS ABOVE 10000
-- =====================================================

SELECT
    prod_name,
    unit_price
FROM product
WHERE unit_price > 10000;


-- =====================================================
-- UPDATE INVENTORY
-- Example: 10 laptops sold
-- =====================================================

UPDATE inventory
SET quantity_on_hand = quantity_on_hand - 10,
    last_updated = CURDATE()
WHERE inventory_id = 1;


-- =====================================================
-- UPDATE SALES ORDER STATUS
-- =====================================================

UPDATE sales_order
SET status = 'Delivered'
WHERE so_id = 1;


